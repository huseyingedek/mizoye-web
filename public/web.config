<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mizoye - IIS ayarlari (statik Next.js export)
  public/ altinda durdugu icin her `npm run build` sonrasi out/ icine otomatik kopyalanir.
-->
<configuration>
  <system.webServer>
    <!-- trailingSlash: true -> /cozumler/ istegi cozumler/index.html'i acar -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- Olmayan sayfalarda Next'in urettigi 404.html gosterilsin -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

  <!-- opengraph-image uzantisiz bir PNG; IIS'in sunabilmesi icin MIME tanimi -->
  <location path="opengraph-image">
    <system.webServer>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="image/png" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Parmak izli Next varliklari: 1 yil onbellek -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
